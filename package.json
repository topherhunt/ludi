{
  "name": "ludi-music",
  "productName": "Ludi",
  "version": "0.1.0",
  "description": "Fast, intuitive, lightweight MacOS music library & player",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173/index.html && VITE_DEV=true electron .\"",
    "vite": "vite",
    "vite:build": "vite build",
    "test": "playwright test",
    "test:unit": "vitest",
    "postinstall": "electron-rebuild"
  },
  "keywords": [
    "music",
    "player",
    "electron",
    "macos"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@solidjs/testing-library": "^0.8.10",
    "concurrently": "^9.2.1",
    "electron": "^28.0.0",
    "electron-rebuild": "^3.2.9",
    "jsdom": "^27.3.0",
    "playwright": "^1.57.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^9.2.0",
    "bootstrap-icons": "^1.13.1",
    "howler": "^2.2.4",
    "music-metadata": "^7.14.0",
    "solid-js": "^1.9.10"
  }
}
