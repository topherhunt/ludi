{
  "name": "ludi-music",
  "productName": "Ludi",
  "version": "0.1.0",
  "description": "Fast, intuitive, lightweight MacOS music library & player",
  "main": "src/main/main.js",
  "scripts": {
    "prestart": "vite build",
    "start": "electron .",
    "dev": "node scripts/dev.js",
    "vite": "vite",
    "vite:build": "vite build",
    "release": "vite build && electron-builder",
    "test": "playwright test",
    "test:unit": "vitest",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "music",
    "player",
    "electron",
    "macos"
  ],
  "author": "Topher Hunt",
  "license": "MIT",
  "build": {
    "appId": "com.topherhunt.ludi",
    "productName": "Ludi",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/renderer/**/*",
      "src/main/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@solidjs/testing-library": "^0.8.10",
    "concurrently": "^9.2.1",
    "electron": "^42.4.1",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.3.0",
    "playwright": "^1.57.0",
    "vite": "^7.3.0",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.16",
    "wait-on": "^9.0.3"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "bootstrap-icons": "^1.13.1",
    "howler": "^2.2.4",
    "music-metadata": "^7.14.0",
    "solid-js": "^1.9.10"
  }
}
